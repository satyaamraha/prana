{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode gzip

	# Always revalidate the shell and service worker so updates reach installed apps.
	@fresh path / /index.html /sw.js /manifest.webmanifest
	header @fresh Cache-Control "no-cache"
	# Scripts/styles revalidate on every load (cheap 304s via ETag) so the
	# shell and code never mismatch; the service worker handles offline speed.
	header /css/* Cache-Control "no-cache"
	header /js/* Cache-Control "no-cache"
	header /icons/* Cache-Control "public, max-age=86400"

	# Android app ↔ site verification (Trusted Web Activity). Must be JSON, no redirects.
	@assetlinks path /.well-known/assetlinks.json
	header @assetlinks Content-Type "application/json"
	header @assetlinks Cache-Control "public, max-age=3600"

	@manifest path *.webmanifest
	header @manifest Content-Type "application/manifest+json"

	file_server
}
