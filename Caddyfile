{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode gzip

	# Always revalidate the shell and service worker so updates reach installed apps.
	@fresh path / /index.html /sw.js /manifest.webmanifest
	header @fresh Cache-Control "no-cache"
	header /css/* Cache-Control "public, max-age=3600"
	header /js/* Cache-Control "public, max-age=3600"
	header /icons/* Cache-Control "public, max-age=86400"

	@manifest path *.webmanifest
	header @manifest Content-Type "application/manifest+json"

	file_server
}
